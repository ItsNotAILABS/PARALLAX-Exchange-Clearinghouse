  "alpha_gates": [
    "no_live_money_movement",
    "no_live_broker_routing",
    "all_commands_pass_risk_policy_gate",
    "all_state_transitions_emit_receipts",
    "operator_halt_available",
    "testnet_and_live_modes_separated",
    "public_claims_match_evidence",
