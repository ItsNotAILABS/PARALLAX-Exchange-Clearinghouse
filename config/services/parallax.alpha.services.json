{
  "schema": "parallax.alpha.services.v1",
  "platform": "PARALLAX",
  "mode": "alpha",
  "public_posture": "paper_testnet_first",
  "generated_at": "2026-07-09",
  "service_planes": [
    "user_surface",
    "execution",
    "ledger",
    "proof",
    "governance",
    "research",
    "ops"
  ],
  "services": [
