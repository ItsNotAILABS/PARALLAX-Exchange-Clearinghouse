      "name": "Market Data Service",
      "plane": "execution",
      "status": "alpha_required",
      "owner": "trade",
      "purpose": "Serve paper markets, symbols, synthetic books, and testnet market metadata.",
      "alpha_capabilities": ["paper_pairs", "order_book_snapshot", "recent_fills", "symbol_registry"],
      "contracts": ["MarketPair", "OrderBookSnapshot", "TradePrint", "SymbolRegistryEntry"],
