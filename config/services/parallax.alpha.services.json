      "name": "Matching Engine",
      "plane": "execution",
      "status": "alpha_required",
      "owner": "clearinghouse",
      "purpose": "Maintain paper order books and produce deterministic fill records.",
      "alpha_capabilities": ["price_time_priority", "partial_fill", "full_fill", "cancel_open_order"],
