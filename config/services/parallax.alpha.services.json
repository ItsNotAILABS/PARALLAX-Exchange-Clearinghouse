      "exposes": ["/chains", "/chains/{id}/health", "/tokens"],
      "must_not_do": ["bridge_live_assets_in_alpha", "mix_chain_modes"]
    },
    {
      "id": "notification-service",
      "name": "Notification Service",
      "plane": "ops",
      "status": "alpha_optional",
      "owner": "ops",
