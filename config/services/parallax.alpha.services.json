      "exposes": ["/governance/halt", "/governance/resume", "/governance/releases"],
      "must_not_do": ["anonymous_admin_action", "unlogged_policy_change"]
    },
    {
      "id": "compliance-boundary-service",
      "name": "Compliance Boundary Service",
      "plane": "governance",
      "status": "alpha_required",
      "owner": "compliance",
