{"schema":"parallax.multi_model_agents.v1","posture":"paper_testnet_first","authorityRepo":"ItsNotAILABS/PARALLAX-Exchange-Clearinghouse","purpose":"Define multiple bounded model roles and agents for PARALLAX paper/testnet automation, receipt writing, risk gating, and federation routing.","hardBoundaries":{"liveMoneyMovement":false,"liveBrokerExecution":false,"custody":false,"regulatedExchangeActivity":false,"publicMainnetBridge":false,"secretsInPrompts":false,"autonomousLiveTrading":false},"modelRoles":[{"id":"model.feeder_classifier","kind":"classifier","job":"classify feeder repo artifacts as public_safe, private_summary, review_required, or blocked","inputs":["repo","lane","sourcePath","artifactSummary"],"outputs":["classification","reasons","requiredReceipt"]},{"id":"model.risk_gatekeeper","kind":"risk_model","job":"score paper/testnet actions for policy, notional, venue, and approval risk","inputs":["command","walletPolicy","signal","usage"],"outputs":["riskScore","decision","approvalRequired"]},{"id":"model.execution_router","kind":"router","job":"route allowed requests to paper_order, research_mint, internal_settlement, proof_room, or blocked","inputs":["useCase","riskDecision","boundary"],"outputs":["route","agent","executionMode"]},{"id":"model.receipt_writer","kind":"receipt_model","job":"write deterministic proof summaries and hashable receipt payloads","inputs":["agentTrace","command","evaluation"],"outputs":["receiptPayload","proofRoomRecord","merkleLabel"]},{"id":"model.market_sentinel","kind":"signal_model","job":"normalize market signals into bounded paper-trading signal envelopes","inputs":["symbol","price","confidence","freshnessSeconds","notional"],"outputs":["signalEnvelope","pressure","freshnessGate"]},{"id":"model.governance_notary","kind":"governance_model","job":"turn SNS and token governance proposals into notary-prep records without token-sale or custody claims","inputs":["proposal","tokenPolicy","boundary"],"outputs":["notaryRecord","blockedClaims","governanceReceipt"]}],"agents":[{"id":"agent.mercator","role":"market_reader","models":["model.market_sentinel"],"canExecute":false},{"id":"agent.custos","role":"risk_guardian","models":["model.risk_gatekeeper"],"canExecute":false},{"id":"agent.ordinator","role":"execution_router","models":["model.execution_router"],"canExecute":false},{"id":"agent.probator","role":"proof_validator","models":["model.receipt_writer"],"canExecute":false},{"id":"agent.scriptor","role":"receipt_writer","models":["model.receipt_writer"],"canExecute":false},{"id":"agent.foederator","role":"repo_federation_ingestor","models":["model.feeder_classifier"],"canExecute":false},{"id":"agent.notarius","role":"sns_governance_notary","models":["model.governance_notary","model.receipt_writer"],"canExecute":false},{"id":"agent.executor","role":"paper_execution_submitter","models":["model.execution_router","model.risk_gatekeeper"],"canExecute":true,"executionModes":["paper","testnet"]}],"routes":[{"id":"route.paper_signal_to_order","agents":["agent.mercator","agent.custos","agent.ordinator","agent.probator","agent.executor","agent.scriptor"],"output":"paperOrderReceipt"},{"id":"route.feeder_to_training_record","agents":["agent.foederator","agent.custos","agent.scriptor"],"output":"trainingRecordReceipt"},{"id":"route.sns_proposal_to_notary_record","agents":["agent.notarius","agent.custos","agent.scriptor"],"output":"governanceReceipt"}],"releaseGate":"pnpm multi:agents && pnpm alpha:models"}
