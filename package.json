{
  "name": "@parallax/exchange-clearinghouse",
  "type": "module",
  "engines": { "node": ">=16.0.0", "pnpm": ">=7.0.0", "npm": "please use pnpm" },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check": "pnpm -r --if-present run check",
    "fix": "pnpm -r --if-present run fix",
    "test": "pnpm -r --if-present run test",
    "alpha:validate": "node scripts/validate-alpha-services.mjs",
    "alpha:gate": "pnpm alpha:validate && pnpm typecheck && pnpm test",
    "ai-wallet:build": "pnpm --filter @parallax/ai-wallet build",
    "ai-wallet:typecheck": "pnpm --filter @parallax/ai-wallet typecheck",
    "ai-wallet:test": "pnpm --filter @parallax/ai-wallet test",
    "alpha:wallet": "pnpm ai-wallet:typecheck && pnpm ai-wallet:test",
    "latin:agents": "pnpm ai-wallet:test",
    "multi:agents": "node scripts/validate-multi-model-agents.mjs && pnpm ai-wallet:test",
    "platform:dev": "node scripts/serve-parallax-platform.mjs",
    "platform:validate": "node scripts/validate-platform-api.mjs",
    "polyglot:validate": "node scripts/validate-polyglot-builder-runtime.mjs",
    "alpha:polyglot": "pnpm polyglot:validate",
    "alpha:platform": "pnpm platform:validate && pnpm alpha:polyglot && pnpm multi:agents",
    "native:configure": "cmake -S src/native/ai-wallet -B build/native/ai-wallet",
    "native:build": "cmake --build build/native/ai-wallet",
    "native:test": "ctest --test-dir build/native/ai-wallet --output-on-failure",
    "alpha:native": "pnpm native:configure && pnpm native:build && pnpm native:test",
    "product:validate": "node scripts/validate-parallax-product.mjs",
    "crypto:funding:validate": "node scripts/validate-crypto-user-funding.mjs",
    "edge:crypto:validate": "node scripts/validate-crypto-edge-api.mjs",
    "usmx:wallet:validate": "node scripts/validate-us-mexico-wallet-fx.mjs",
    "private-cloud:validate": "node scripts/validate-private-clouds.mjs",
    "repo-federation:validate": "node scripts/validate-repo-federation.mjs",
    "usecases:validate": "node scripts/validate-model-training.mjs",
    "training:build": "node scripts/build-model-training-dataset.mjs",
    "training:validate": "node scripts/validate-model-training.mjs",
    "commercial:validate": "node scripts/validate-commercial-grade.mjs",
    "alpha:models": "pnpm repo-federation:validate && pnpm training:build && pnpm training:validate && pnpm latin:agents && pnpm multi:agents && pnpm alpha:platform && pnpm commercial:validate",
    "alpha:commercial": "pnpm commercial:validate && pnpm crypto:funding:validate && pnpm edge:crypto:validate && pnpm usmx:wallet:validate && pnpm alpha:models && pnpm alpha:product && pnpm alpha:launch",
    "edge:dev": "pnpm --dir apps/cloudflare-gateway dev",
    "edge:deploy": "pnpm --dir apps/cloudflare-gateway deploy",
    "edge:typecheck": "pnpm --dir apps/cloudflare-gateway typecheck",
    "alpha:product": "pnpm product:validate && pnpm crypto:funding:validate && pnpm edge:crypto:validate && pnpm usmx:wallet:validate && pnpm edge:typecheck && pnpm private-cloud:validate && pnpm repo-federation:validate && pnpm training:validate && pnpm latin:agents && pnpm multi:agents && pnpm alpha:platform && pnpm commercial:validate",
    "icp:ai-wallet:deploy": "dfx deploy ai_wallet_ledger",
    "icp:ai-wallet:test": "bash canisters/ai-wallet-ledger/tests/integration.sh",
    "icp:ai-wallet:version": "dfx canister call ai_wallet_ledger getVersion '()'",
    "icp:ai-wallet:benchmarks": "dfx canister call ai_wallet_ledger listBenchmarks '(null, opt 20)'",
    "alpha:icp-wallet": "pnpm icp:ai-wallet:deploy && pnpm icp:ai-wallet:test",
    "defi:deploy": "dfx deploy defi_exchange",
    "defi:test": "bash canisters/defi-exchange/tests/integration.sh",
    "defi:version": "dfx canister call defi_exchange getVersion '()'",
    "defi:benchmarks": "dfx canister call defi_exchange list_benchmarks '(null, opt 20)'",
    "alpha:defi": "pnpm defi:deploy && pnpm defi:test",
    "launch:validate": "node scripts/validate-universal-launch.mjs",
    "terminal:validate": "node scripts/validate-trading-terminal.mjs",
    "sovereign:validate": "node scripts/validate-sovereign-finance.mjs",
    "launch:serve": "python3 -m http.server 5174 -d .",
    "alpha:launch": "pnpm launch:validate && pnpm terminal:validate && pnpm sovereign:validate && pnpm crypto:funding:validate && pnpm edge:crypto:validate && pnpm usmx:wallet:validate && pnpm private-cloud:validate && pnpm repo-federation:validate && pnpm training:validate && pnpm latin:agents && pnpm multi:agents && pnpm alpha:platform && pnpm commercial:validate",
    "bindgen": "caffeine-bindgen --did-file ./src/backend/dist/backend.did --out-dir ./src/frontend/src --actor-interface-file --force",
    "parallax": "node tools/parallax-dev/src/cli.js",
    "scaffold": "node tools/parallax-dev/src/cli.js scaffold",
    "substrate:bindgen": "node tools/parallax-dev/src/cli.js bindgen",
    "substrate:deploy": "node tools/parallax-dev/src/cli.js deploy",
    "substrate:status": "node tools/parallax-dev/src/cli.js status",
    "substrate:list": "node tools/parallax-dev/src/cli.js list",
    "substrate:sync": "node tools/parallax-dev/src/cli.js sync"
  },
  "devDependencies": { "sharp": "^0.34.4" },
  "dependencies": { "@caffeineai/core-infrastructure": "^0.2.0" }
}
